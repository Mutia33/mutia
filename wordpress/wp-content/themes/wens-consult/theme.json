{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"settings": {
		"appearanceTools": true,
		"color": {
			"duotone": [
				{
					"colors": [
						"#00a0d2",
						"#0073aa"
					],
					"name": "Secondary and primary",
					"slug": "secondary-primary"
				},
				{
					"colors": [
						"#0073aa",
						"#2b2b2b"
					],
					"name": "Primary and Contrast",
					"slug": "primary-contrast"
				}
			],
			"gradients": [
				{
					"gradient": "linear-gradient(#0073aa 49.9%,#fff 50%)",
					"name": "Primary color to white",
					"slug": "primary-white"
				},
				{
					"gradient": "linear-gradient(#fff 49.9%,#0073aa 50%)",
					"name": "Horizontal white to Primary color",
					"slug": "white-primary"
				}
			],
			"palette": [
				{
					"color": "#ffffff",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#2b2b2b",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#091057",
					"name": "Primary",
					"slug": "primary"
				},
				{
					"color": "#024caa",
					"name": "Secondary",
					"slug": "secondary"
				},
				{
					"color": "transparent",
					"name": "Transparent",
					"slug": "transparent"
				},
				{
					"color": "#e2ffc2",
					"name": "Color 1",
					"slug": "custom-color-1"
				},
				{
					"color": "#003433",
					"name": "Color 2",
					"slug": "custom-color-2"
				},
				{
					"color": "#f3f4f6",
					"name": "Color 3",
					"slug": "custom-color-3"
				},
				{
					"color": "#e1e1e1",
					"name": "Color 4",
					"slug": "custom-color-4"
				},
				{
					"color": "#3c3c3c",
					"name": "Color 5",
					"slug": "custom-color-5"
				},
				{
					"color": "#212529",
					"name": "Color 6",
					"slug": "custom-color-6"
				}
			]
		},
		"layout": {
			"contentSize": "900px",
			"wideSize": "1320px"
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"fontFace": [
						{
							"fontFamily": "Figtree",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": "file:./assets/fonts/figtree/figtree.woff2"
						}
					],
					"fontFamily": "Figtree, sans-serif",
					"name": "Figtree",
					"slug": "figtree"
				},
				{
					"fontFace": [
						{
							"fontFamily": "\"Playfair Display\"",
							"fontStyle": "normal",
							"fontWeight": "600",
							"src": "file:./assets/fonts/playfair-display/playfair-display.woff2"
						}
					],
					"fontFamily": "\"Playfair Display\", serif",
					"name": "Playfair Display",
					"slug": "playfair-display"
				}
			],
			"fontSizes": [
				{
					"fluid": false,
					"name": "Small",
					"size": "1.125rem",
					"slug": "small"
				},
				{
					"fluid": false,
					"name": "Medium",
					"size": "1.5rem",
					"slug": "medium"
				},
				{
					"fluid": {
						"max": "2rem",
						"min": "1.75rem"
					},
					"name": "Large",
					"size": "2rem",
					"slug": "large"
				},
				{
					"fluid": {
						"max": "2.75rem",
						"min": "2.5rem"
					},
					"name": "XL",
					"size": "2.75rem",
					"slug": "x-large"
				},
				{
					"fluid": {
						"max": "3.75rem",
						"min": "3rem"
					},
					"name": "XXL",
					"size": "3.75rem",
					"slug": "xx-large"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"blocks": {
			"core/code": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"core/comment-author-name": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/comment-date": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/comment-edit-link": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/comment-reply-link": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/heading": {
				"typography": {
					"lineHeight": "1.3"
				}
			},
			"core/navigation": {
				"css": "& .wp-block-site-title{ margin:0; font-weight:400;}",
				"elements": {
					"link": {
						":active": {
							"color": {
								"text": "var(--wp--preset--color--contrast)"
							}
						},
						":focus": {
							"color": {
								"text": "var(--wp--preset--color--contrast)"
							}
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--contrast)"
							},
							"typography": {
								"textDecoration": "none"
							}
						},
						"color": {
							"text": "var(--wp--preset--color--contrast)"
						},
						"typography": {
							"textDecoration": "underline"
						}
					}
				}
			},
			"core/post-author-name": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/post-comments-form": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/post-content": {
				"spacing": {
					"margin": {
						"bottom": "var(--wp--preset--spacing--60)",
						"top": "var(--wp--preset--spacing--60)"
					}
				}
			},
			"core/post-date": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/post-excerpt": {
				"elements": {
					"link": {
						"typography": {
							"fontSize": "var(--wp--preset--font-size--small)"
						}
					}
				}
			},
			"core/post-featured-image": {
				"spacing": {
					"margin": {
						"bottom": "var(--wp--preset--spacing--40)"
					}
				}
			},
			"core/post-template": {
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--60)",
					"padding": {
						"bottom": "var(--wp--preset--spacing--50)",
						"top": "var(--wp--preset--spacing--50)"
					}
				}
			},
			"core/post-terms": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/post-title": {
				"typography": {
					"lineHeight": "1.3"
				}
			},
			"core/query-pagination": {
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--50)"
					}
				}
			},
			"core/search": {
				"color": {
					"text": "var(--wp--preset--color--custom-color-4)"
				},
				"css": ".wp-block-search__button-inside .wp-block-search__inside-wrapper{border: none;}",
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--custom-color-4)"
						}
					}
				},
				"typography": {
					"lineHeight": "1"
				}
			}
		},
		"color": {
			"background": "var(--wp--preset--color--custom-color-3)",
			"text": "#202020"
		},
		"css": ".wp-element-button,\n.wpcf7-submit,\n.wp-block-button__link {\n    background:#E2FFC2;\n    color: #000;\n    font-size: 15px;\n    border-radius:5px !important;\n    padding: 10px 36px !important; \nborder: 2px solid #E2FFC2;\n}\n@media only screen and (max-width: 600px) {\n.wp-element-button,\ninput[type=\"button\"],\ninput[type=\"submit\"],\n.wp-block-button__link,\n.wp-element-button,\n.wpcf7-submit,\n.wp-block-button__link {\n    font-size: 14px;\n    padding: 10px 20px !important; \n}\n}\ninput.wp-element-button:hover,\n.wpcf7-submit:hover,\n.wp-block-button__link:hover,\ninput.wp-element-button:focus,\n.wpcf7-submit:focus,\n.wp-block-button__link:focus {\nbackground-color:#E2FFC2 !important;\ncolor: #000 !important;\nborder: 2px solid #E2FFC2;\n\n}\n\n.page-numbers.current,\na:focus,\na:hover{\ncolor: var(--wp--preset--color--secondary);\n}\n\n.wp-block-query-pagination a,\n.wp-block-comment-date a,\n.wp-block-comment-author-name a,\n.wp-block-navigation-submenu a,\n.wp-block-navigation-link a,\n.wp-block-categories a,\n.wp-block-post-title a,\n.wp-block-site-title a{\n   text-decoration: none !important;\n}\n\n.about-section-image-relative{\n    z-index: 2;\n    position: relative !important;\n}\n\n\n.testimonial-relative-post-content,\n.about-relative-post-content{\nz-index: 2;\n    position: relative !important;\n}\n\n.wpcf7-text{\nwidth: 100%;\nheight: 30px;\n}\n\n.wpcf7-textarea{\nwidth: 100%;\n}\n\n.single .wp-block-post-terms a {\n    border: 1px solid;\n    border-radius: 2px;\n    padding: 5px;\n    margin: 5px;\n    text-decoration: none;\n}\n\n@media only screen and (max-width: 1000px) {\n  .mobile-disable{\n      display:none;\n  }\n}\n\n\n.ac .ac-trigger {\n    padding: 16px 32px 16px 16px!important;\n   \n}\n.ac-header, .ac-panel {\n     border-radius: 5px!important;\n}\n.ac {\n    border-radius: 5px!important;\nmargin-top: 24px;\n}\n@media only screen and (max-width: 1024px) {\n.wp-block-navigation__responsive-container-open:not(.always-shown) {\n        display: block !important;\n    }\nheader .wp-block-navigation__responsive-container{\ndisplay: none !important;\n}\nheader .wp-block-navigation__responsive-container.is-menu-open{\ndisplay: block !important;\n}\n}\n\n@media (max-width: 781px) {\n.wrap-the-columns\n {\ndisplay:grid!important;\n  grid-template-columns: repeat(2, minmax(0, 1fr))!important;\n}\n}\n@media (max-width: 599px) {\n.wrap-the-columns\n {\ndisplay:grid!important;\n  grid-template-columns: repeat(1, minmax(0, 1fr))!important;\n}\n.padding-faq{\n    padding-top: 60px!important;\n    padding-right: 24px!important;\n    padding-bottom: 60px!important;\n    padding-left: 24px!important;\n}\n.social-logos{\ndisplay:none!important;\n}\n.consult-banner{\nmin-height:350px!important;\n}\n.project-cover{\nmin-height:300px!important;\n}\n#process-gap{\nmargin-top: 72px!important;\n}\n}\n\n@media (max-width: 781px) {\n#clents-no .wrap-the-columns\n{\ndisplay: grid!important;\n grid-template-columns: repeat(6, minmax(0, 1fr))!important;\n}\n}\n@media (max-width: 599px) {\n#clents-no .wrap-the-columns\n{\ndisplay: grid!important;\n grid-template-columns: repeat(3, minmax(0, 1fr))!important;\n}\n}\n.wpcf7 input,\n.wpcf7 textarea {\n   padding: 14px;\n  border-radius: 5px;\n  border: 2px solid #ccc;\n}\n\n.wpcf7 input[type=\"submit\"] {\n  padding: 12px 20px;\n   border-radius: 5px;\n}",
		"elements": {
			"button": {
				":hover": {
					"border": {
						"color": "var(--wp--preset--color--secondary)"
					}
				},
				"border": {
					"color": "var(--wp--preset--color--transparent)",
					"radius": "4px",
					"style": "solid",
					"width": "4px"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--contrast)"
				},
				"shadow": "var(--wp--preset--shadow--natural)",
				"spacing": {
					"padding": {
						"bottom": "var(--wp--preset--spacing--30)",
						"left": "var(--wp--preset--spacing--30)",
						"right": "var(--wp--preset--spacing--30)",
						"top": "var(--wp--preset--spacing--30)"
					}
				},
				"typography": {
